rules_version = '2';

// Reglas de Firestore — Por Mí | The New Technological Republic (proyecto the-new-republic-1).
// Esquema de colecciones: docs/DATABASE.md
//
// Importante: las rutas /api usan Firebase Admin, que NO pasa por estas reglas.
// Estas reglas solo controlan lo que el navegador puede hacer directamente.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Campos del perfil que el navegador puede escribir (login). Todo lo demás
    // (compras purchased_*, rol, etapa) solo lo escribe el servidor.
    function profileFields() {
      return ['uid', 'email', 'displayName', 'photoURL', 'lastLogin'];
    }

    // ── Perfil del cliente ──────────────────────────────────────────────
    // El login crea/actualiza su propio documento; el portal lo escucha en tiempo real.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields().concat(['role', 'createdAt']))
        && request.resource.data.role == 'client';
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields());
      allow delete: if false;
    }

    // ── Formularios públicos de aplicación / onboarding (links compartidos) ──
    match /contacts/{contactId} {
      allow read, write: if signedIn();
    }

    // ── Solo servidor (Firebase Admin desde /api) ───────────────────────
    match /solicitudes_visas/{caseId} { allow read, write: if false; }
    match /staff_hidden_cases/{docId} { allow read, write: if false; }
    match /referrals/{docId} { allow read, write: if false; }
    match /portal_chats/{chatId} {
      allow read, write: if false;
      match /{rest=**} { allow read, write: if false; }
    }
    match /cards/{cardId} { allow read, write: if false; }
    match /pendingPurchases/{docId} { allow read, write: if false; }

    // Pagos con cripto (QR) — escritos solo por el servidor.
    match /visaCryptoSessions/{sessionId} {
      allow read, write: if false;
      match /paymentRequests/{requestId} { allow read, write: if false; }
    }
    match /visaCryptoComprobantes/{comprobanteId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Módulos heredados (suite / chatbots) ─────────────────────────────
    match /kanban-groups/{groupId} {
      allow read, write: if signedIn();
      match /cards/{cardId} { allow read, write: if signedIn(); }
    }
    match /chatbots/{botId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Todo lo demás queda cerrado por defecto.
  }
}
